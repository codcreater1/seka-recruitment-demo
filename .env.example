# Copy to .env.local for local development. In Coolify set these as environment variables.

# Sign-in. "demo" (default): demo accounts on the sign-in page, no passwords, so protect any public address with
# DEMO_PASSWORD. "entra": Microsoft Entra ID, see docs/entra-id.md.
AUTH_MODE=demo
# Long random string that signs the session cookie. Empty: one is generated and kept in the data folder.
SESSION_SECRET=
# Microsoft Entra ID (AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Public address of the app, e.g. https://rekrutacja.seka.pl (builds the redirect URI)
APP_URL=
# Optional, roles from group ids: {"<group id or role name>": "admin" | "hr" | "manager:Kraków"}
ENTRA_ROLE_MAP=

# Password gate for a publicly reachable demo (HTTP Basic auth, any user name).
# Leave empty to disable. Recommended whenever the app is reachable from the internet.
DEMO_PASSWORD=

# Shared secret for POST /api/ingest (Power Automate). Leave empty to disable the endpoint.
INGEST_API_KEY=

# Months after which a profile is flagged as past its retention period.
RETENTION_MONTHS=6
# Same, for candidates who consented to future recruitments (talent pool).
POOL_RETENTION_MONTHS=24

# Load the fictional demo candidates on first start (when the database is empty).
SEED_DEMO_DATA=true

# Time zone of the company. Interview times are wall-clock times; "upcoming" is decided in this zone.
APP_TIMEZONE=Europe/Warsaw

# Outgoing e-mail (acknowledgement, invitation, thank-you). Without SMTP_HOST messages are only recorded
# on the profile as "symulacja" and nothing is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Where the SQLite database and uploaded CVs live. Default: ./data (Docker image: /data).
# DATA_DIR=./data
