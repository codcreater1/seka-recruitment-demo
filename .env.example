# Copy to .env.local for local development. In Coolify set these as environment variables.

# Password gate for a publicly reachable demo (HTTP Basic auth, any user name).
# Leave empty to disable. Recommended whenever the app is reachable from the internet.
DEMO_PASSWORD=

# Shared secret for POST /api/ingest (Power Automate). Leave empty to disable the endpoint.
INGEST_API_KEY=

# Months after which a profile is flagged as past its retention period.
RETENTION_MONTHS=6

# Load the fictional demo candidates on first start (when the database is empty).
SEED_DEMO_DATA=true

# Outgoing e-mail (acknowledgement, invitation, thank-you). Without SMTP_HOST messages are only recorded
# on the profile as "symulacja" and nothing is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Where the SQLite database and uploaded CVs live. Default: ./data (Docker image: /data).
# DATA_DIR=./data
